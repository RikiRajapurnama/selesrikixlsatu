# ===== XL SATU WiFi - Environment Variables =====
#
# SALIN file ini menjadi `.env` dan isi nilainya.
#
# ===== LOKAL (pakai SQLite) =====
# DATABASE_URL="file:./dev.db"
#
# ===== PRODUKSI VERCEL (wajib PostgreSQL) =====
# 1. Buat database gratis di https://neon.tech atau https://supabase.com
# 2. Salin connection string PostgreSQL-nya ke sini:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
#
# ===== KEAMANAN =====
# Ganti dengan string acak panjang. Contoh: openssl rand -base64 32
JWT_SECRET="ganti-dengan-kunci-rahasia-acak-yang-panjang"

# Password admin default (hasil seeder): admin123
# Email admin: admin@xlwifi.com